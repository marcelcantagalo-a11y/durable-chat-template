name = "durable-chat-template"
main = "src/index.ts"
compatibility_date = "2024-01-01"

# Variáveis de ambiente para Twitch
[vars]
TWITCH_CLIENT_ID = "SEU_CLIENT_ID_AQUI"
TWITCH_CLIENT_SECRET = "SEU_CLIENT_SECRET_AQUI"
TWITCH_REDIRECT_URI = "https://seu-app.workers.dev/twitch/callback"

# Durable Objects
[[durable_objects]]
bindings = [
  { name = "Chat", class_name = "Chat" }
]

[[migrations]]
tag = "v1"
new_classes = ["Chat"]
